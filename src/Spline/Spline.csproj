<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Spline</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Spline</PackageId>
    <RootNamespace>Spline</RootNamespace>
    <Title>Spline</Title>
    <Version>0.2.0</Version>
    <Description>Reusable fair-spline and CAD-style global B-spline geometry, interpolation, evaluation, and Bezier path utilities for .NET.</Description>
    <PackageTags>spline;bspline;nurbs;cad;bezier;geometry;curves;interpolation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Introduce production global cubic B-spline interpolation from fit points and endpoint tangents, canonical CAD B-spline geometry, de Boor evaluation and derivatives, exact cubic Bezier conversion, discontinuous-knot-safe path export, comprehensive tests, samples, and documentation.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
